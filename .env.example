# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.
# « Publique » : préfixée NEXT_PUBLIC_, incluse dans le code envoyé au navigateur.
# « Secrète » : lue côté serveur uniquement.

# --- Site ---
# Secrète (non sensible) : URL publique du site, sans / final.
BASE_URL=https://example.com
# Secrète : emails des administrateurs de la plateforme (/admin), séparés par des virgules.
PLATFORM_ADMIN_EMAILS=admin@example.com

# --- Supabase ---
# Publique : URL du projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Publique : clé anon (protégée par la RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secrète : clé service_role, contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apple Wallet (certificat partagé) ---
# Secrète (non sensible) : Pass Type ID partagé.
APPLE_PASS_TYPE_ID=pass.com.example.loyalty
# Secrète (non sensible) : Team ID du compte développeur Apple.
APPLE_TEAM_ID=
# Secrète : certificat de signature des passes (PEM encodé en base64). Sert aussi à APNs.
APPLE_SIGNER_CERT_BASE64=
# Secrète : clé privée du certificat de signature (PEM encodé en base64).
APPLE_SIGNER_KEY_BASE64=
# Secrète : phrase de passe de la clé privée, vide si aucune.
APPLE_SIGNER_KEY_PASSPHRASE=
# Secrète (non sensible) : certificat intermédiaire Apple WWDR (PEM encodé en base64).
APPLE_WWDR_CERT_BASE64=

# --- Apple : un Pass Type ID par commerce (App Store Connect API) ---
# Secrète : identifiants de la clé API App Store Connect.
ASC_ISSUER_ID=
ASC_KEY_ID=
# Secrète : clé .p8 encodée en base64.
ASC_PRIVATE_KEY=
# Secrète : chiffre en base les clés privées des certificats (32 octets : openssl rand -base64 32).
PASS_CERTS_ENCRYPTION_KEY=

# --- Google Wallet ---
# Secrète (non sensible) : Issuer ID Google Wallet.
GOOGLE_WALLET_ISSUER_ID=
# Secrète : email du compte de service Google.
GOOGLE_SA_EMAIL=service-account@votre-projet.iam.gserviceaccount.com
# Secrète : clé JSON du compte de service, encodée en base64.
GOOGLE_SA_KEY_BASE64=

# --- Emails (Resend) ---
# Secrète : clé API Resend.
RESEND_API_KEY=
# Secrète (non sensible) : domaine d'envoi vérifié (expéditeur hello@<domaine>).
RESEND_EMAIL_DOMAIN=example.com

# --- Tâches planifiées ---
# Secrète : jeton attendu par /api/cron/* (Vercel l'envoie automatiquement).
CRON_SECRET=

# --- Débogage (facultatif) ---
# Secrète (non sensible) : 1 pour tracer le chargement des images des passes.
DEBUG_PASS_ASSETS=
